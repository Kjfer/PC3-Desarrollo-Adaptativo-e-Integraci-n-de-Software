# Conexión a SQL Server. Copiar a .env y ajustar. Las credenciales solo van en .env.
SQL_SERVER=localhost
SQL_DRIVER=ODBC Driver 18 for SQL Server
# yes = autenticación de Windows (no requiere usuario ni clave)
SQL_TRUSTED_CONNECTION=yes
# Solo si SQL_TRUSTED_CONNECTION=no
SQL_USER=
SQL_PASSWORD=
# Instancia local con certificado autofirmado
SQL_TRUST_SERVER_CERTIFICATE=yes
